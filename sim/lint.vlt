`verilator_config
// Power-up values on registers are intentional: Quartus loads them at configuration,
// and the bridge-side logic runs before reset_n is released.
lint_off -rule PROCASSINIT
// Third-party IP, kept unmodified
lint_off -file "core/src/fpga/core/ip/*"
// Generated by tools/vexriscv/gen.sh, not edited by hand
lint_off -file "core/src/fpga/core/cpu/*"
// Third-party FM chip (core/src/fpga/core/jtopl/README.md), kept as it is
lint_off -file "core/src/fpga/core/jtopl/*"
